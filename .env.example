# AdvantShop storefront / API
ADVANTSHOP_BASE_URL=https://shop.synonym-jewelry.ru
ADVANTSHOP_SERVER_API_KEY=your_server_api_key

# Admin CSV 2.0 import (рабочий путь для остатков/цен) — для GitHub Actions
ADVANTSHOP_ADMIN_URL=https://my.advantshop.net/437286-kfbw
ADVANTSHOP_ADMIN_EMAIL=import@synonym-jewelry.ru
ADVANTSHOP_ADMIN_PASSWORD=secret
# SYNC_ADMIN_ONLY_UPDATE=true
# Товары магазина, которых нет в CSV из 1С: zero | none | deactivate | delete
# SYNC_ADMIN_MISSING_ACTION=zero
# SYNC_POST_ENABLED=true

# FTP (1С) — для Amvera Cron (GitHub Actions до FTP не достучится)
FTP_HOST=95.79.55.253
FTP_USER=sinonim
FTP_PASSWORD=secret
FTP_REMOTE_PATH=/stocks.csv
FTP_PORT=2131
FTP_SECURE=false

# --- Схема обхода сети ---
# Amvera:  SYNC_UPLOAD_MODE=relay-github  (+ FTP_* + SYNC_GITHUB_TOKEN)
# Actions: SYNC_UPLOAD_MODE=admin         (+ ADVANTSHOP_ADMIN_* + file data/stocks-latest.csv)
#
# SYNC_UPLOAD_MODE=relay-github
